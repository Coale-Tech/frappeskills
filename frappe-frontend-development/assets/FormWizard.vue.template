<template>
  <Dialog v-model="isOpen" :options="{ title: formTitle, size: 'full' }">
    <template #body>
      <div class="h-[80vh] flex">
        <!-- Progress Sidebar -->
        <div class="w-64 bg-gray-50 border-r border-gray-200 flex-shrink-0 overflow-y-auto">
          <div class="p-4">
            <h4 class="text-sm font-semibold text-gray-900 mb-3">Progress</h4>
            <div class="space-y-2">
              <div
                v-for="(section, index) in sections"
                :key="section.id"
                class="flex items-center space-x-2 p-2 rounded-lg cursor-pointer transition-all"
                :class="currentSection === index ? 'bg-blue-100 border border-blue-300' : 'hover:bg-gray-100'"
                @click="goToSection(index)"
              >
                <div
                  class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-semibold"
                  :class="getSectionStatusClass(section.id)"
                >
                  <CheckIcon v-if="isSectionComplete(section.id)" class="h-3 w-3" />
                  <span v-else>{{ index + 1 }}</span>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-medium text-gray-900 truncate">{{ section.title }}</div>
                  <div class="text-xs text-gray-500 truncate">{{ section.description }}</div>
                </div>
              </div>
            </div>

            <!-- Overall Progress -->
            <div class="mt-4 p-3 bg-white rounded-lg border border-gray-200">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-medium text-gray-700">Overall Progress</span>
                <span class="text-xs font-semibold text-blue-600">{{ overallProgress }}%</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-1.5">
                <div
                  class="bg-blue-600 h-1.5 rounded-full transition-all duration-500"
                  :style="{ width: `${overallProgress}%` }"
                ></div>
              </div>
            </div>

            <!-- Auto-save Status -->
            <div v-if="lastSaved" class="mt-3 text-xs text-gray-500 text-center">
              Last saved: {{ lastSaved }}
            </div>
          </div>
        </div>

        <!-- Main Form Content -->
        <div class="flex-1 overflow-y-auto">
          <div class="p-6 space-y-8">
            <!-- Form Sections -->
            <div v-for="(section, index) in sections" :key="section.id" v-show="currentSection === index">
              <h2 class="text-lg font-semibold text-gray-900 mb-4">{{ section.title }}</h2>
              <div class="bg-white rounded-lg border border-gray-200 p-6">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                  <FormControl
                    v-for="field in section.fields"
                    v-bind="field"
                    v-model="form[field.fieldname]"
                    :label="field.label"
                    :placeholder="field.placeholder"
                    :type="field.type || 'text'"
                    :options="field.options"
                  />
                </div>
              </div>
            </div>

            <!-- Review Section -->
            <div v-show="currentSection === sections.length - 1">
              <h2 class="text-lg font-semibold text-gray-900 mb-4">Review & Submit</h2>
              <div class="bg-white rounded-lg border border-gray-200 p-6">
                <h4 class="text-lg font-semibold text-gray-900 mb-4">{{ formTitle }} Summary</h4>

                <!-- Summary cards -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
                  <div v-for="(value, key) in formSummary" :key="key" class="bg-gray-50 rounded-lg p-4">
                    <p class="text-xs text-gray-500 uppercase">{{ key }}</p>
                    <p class="text-lg font-semibold text-gray-900">{{ value || '-' }}</p>
                  </div>
                </div>

                <!-- Validation checks -->
                <div class="border-t pt-4">
                  <h5 class="text-sm font-medium text-gray-900 mb-3">Validation Status</h5>
                  <div class="space-y-2">
                    <div v-for="check in validationChecks" :key="check.label" class="flex items-center">
                      <CheckCircleIcon v-if="check.valid" class="text-green-500 h-5 w-5 mr-2" />
                      <XCircleIcon v-else class="text-red-500 h-5 w-5 mr-2" />
                      <span :class="check.valid ? 'text-gray-700' : 'text-red-600'" class="text-sm">
                        {{ check.label }}
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </template>

    <template #actions>
      <div class="flex items-center justify-between w-full">
        <Button
          v-if="currentSection > 0"
          variant="outline"
          @click="previousSection"
        >
          Previous
        </Button>

        <div class="flex items-center gap-2">
          <Button
            variant="outline"
            @click="saveDraft"
            :loading="saving"
          >
            Save Draft
          </Button>

          <Button
            v-if="currentSection < sections.length - 1"
            variant="solid"
            theme="blue"
            @click="nextSection"
          >
            Next
          </Button>

          <Button
            v-else
            variant="solid"
            theme="blue"
            @click="submitForm"
            :disabled="!isFormValid"
            :loading="submitting"
          >
            Submit
          </Button>
        </div>
      </div>
    </template>
  </Dialog>
</template>

<script setup>
import { Button, Dialog, FormControl } from 'frappe-ui'
import { CheckCircle2Icon, CheckIcon, XCircleIcon } from 'lucide-vue-next'
import { ref, computed, watch } from 'vue'

const props = defineProps({
  open: Boolean,
  item: Object,
  mode: {
    type: String,
    default: 'create'
  }
})

const emit = defineEmits(['update:open', 'saved', 'close'])

// State
const currentSection = ref(0)
const saving = ref(false)
const submitting = ref(false)
const lastSaved = ref(null)

// Form data
const form = ref(getDefaultForm())

// Sections configuration
const sections = [
  {
    id: 'basic',
    title: 'Basic Information',
    description: 'Enter the basic details',
    fields: [
      { fieldname: 'name', label: 'Name', type: 'text', placeholder: 'Enter name' },
      { fieldname: 'status', label: 'Status', type: 'select', options: statusOptions },
    ]
  },
  {
    id: 'details',
    title: 'Additional Details',
    description: 'Provide additional information',
    fields: [
      { fieldname: 'description', label: 'Description', type: 'textarea', placeholder: 'Enter description' },
    ]
  }
]

// Status options
const statusOptions = [
  { label: 'Active', value: 'Active' },
  { label: 'Draft', value: 'Draft' },
  { label: 'Inactive', value: 'Inactive' },
]

// Computed
const isOpen = computed({
  get: () => props.open,
  set: (val) => emit('update:open', val)
})

const formTitle = computed(() => {
  return props.mode === 'edit' ? `Edit {{ doctype }}` : `New {{ doctype }}`
})

const overallProgress = computed(() => {
  const totalFields = sections.reduce((acc, s) => acc + s.fields.length, 0)
  const filledFields = sections.reduce((acc, s) => {
    return acc + s.fields.filter(f => form.value[f.fieldname]).length
  }, 0)
  return Math.round((filledFields / totalFields) * 100)
})

const isFormValid = computed(() => {
  return !!form.value.name
})

const formSummary = computed(() => ({
  Name: form.value.name || '-',
  Status: form.value.status || '-',
  Description: form.value.description || '-'
}))

const validationChecks = computed(() => [
  { label: 'Name is filled', valid: !!form.value.name },
  { label: 'Status is selected', valid: !!form.value.status },
])

// Methods
function getDefaultForm() {
  return {
    name: '',
    status: 'Draft',
    description: ''
  }
}

function isSectionComplete(sectionId) {
  const section = sections.find(s => s.id === sectionId)
  if (!section) return false
  return section.fields.every(f => form.value[f.fieldname])
}

function getSectionStatusClass(sectionId) {
  return isSectionComplete(sectionId)
    ? 'bg-green-500 text-white'
    : 'bg-gray-300 text-gray-600'
}

function goToSection(index) {
  currentSection.value = index
}

function previousSection() {
  if (currentSection.value > 0) {
    currentSection.value--
  }
}

function nextSection() {
  if (currentSection.value < sections.length - 1) {
    currentSection.value++
  }
}

async function saveDraft() {
  saving.value = true
  try {
    // Save draft logic
    lastSaved.value = new Date().toLocaleTimeString()
  } catch (error) {
    console.error('Error saving draft:', error)
  } finally {
    saving.value = false
  }
}

async function submitForm() {
  submitting.value = true
  try {
    // Submit logic
    emit('saved', form.value)
    isOpen.value = false
  } catch (error) {
    console.error('Error submitting:', error)
  } finally {
    submitting.value = false
  }
}

// Watch for item changes to populate form
watch(() => props.item, (newItem) => {
  if (newItem) {
    form.value = { ...getDefaultForm(), ...newItem }
  }
  currentSection.value = 0
}, { immediate: true })

// Watch for dialog close to reset
watch(() => props.open, (newOpen) => {
  if (!newOpen) {
    currentSection.value = 0
    lastSaved.value = null
  }
})
</script>
