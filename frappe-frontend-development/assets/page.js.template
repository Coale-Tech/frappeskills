// Page registration for v15 desk integration
// Generated from the frappe-frontend-development skill template

frappe.pages['{{ page_name }}'].on_page_load = function(wrapper) {
  var page = frappe.ui.make_app_page({
    parent: wrapper,
    title: __('{{ page_title }}'),
    single_column: true
  })

  // Add primary action button
  page.set_primary_action(__('New {{ doctype }}'), function() {
    frappe.set_route('/{{ route_base }}/new')
  })

  // Mount Vue component
  var $container = page.main.find('.layout-main')

  // Create Vue app with the component
  new Vue({
    render: function(h) {
      return h({{ component_name }})
    }
  }).$mount($container[0])

  // Set up breadcrumbs
  page.add_menu_item('{{ module_title }}', '{{ route_base }}', __('{{ page_title }}'))
}
