<template>
  <div class="p-6">
    <!-- Header -->
    <header class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-4">
        <button @click="$router.back()" class="p-2 hover:bg-gray-100 rounded">
          <ArrowLeft class="w-5 h-5" />
        </button>
        <div>
          <h1 class="text-xl font-bold text-black">{{ item.name }}</h1>
          <p class="text-sm text-gray-500">{{ doctype }}</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <Button
          v-if="item.status === 'Draft'"
          variant="solid"
          theme="green"
          @click="submit"
        >
          Submit
        </Button>
        <Button
          variant="outline"
          @click="edit"
        >
          Edit
        </Button>
      </div>
    </header>

    <!-- Status Banner -->
    <div class="bg-white rounded-lg shadow p-4 mb-6">
      <div class="flex items-center justify-between">
        <Badge
          :label="item.status"
          :theme="getStatusTheme(item.status)"
          variant="subtle"
        />
        <span class="text-sm text-gray-500">
          Created {{ formatDate(item.creation) }}
        </span>
      </div>
    </div>

    <!-- Tabs -->
    <div class="bg-white rounded-lg shadow">
      <div class="border-b">
        <nav class="flex">
          <button
            v-for="tab in tabs"
            :key="tab.key"
            @click="activeTab = tab.key"
            :class="[
              'px-6 py-3 text-sm font-medium border-b-2 transition-colors',
              activeTab === tab.key
                ? 'border-black text-black bg-gray-50'
                : 'border-transparent text-gray-600 hover:text-black'
            ]"
          >
            {{ tab.label }}
          </button>
        </nav>
      </div>

      <div class="p-6">
        <!-- Details Tab -->
        <div v-if="activeTab === 'details'">
          <div class="grid grid-cols-2 gap-6">
            <div>
              <h3 class="text-sm font-medium text-gray-500 mb-1">Name</h3>
              <p class="text-gray-900">{{ item.name }}</p>
            </div>
            <div>
              <h3 class="text-sm font-medium text-gray-500 mb-1">Status</h3>
              <Badge
                :label="item.status"
                :theme="getStatusTheme(item.status)"
                variant="subtle"
              />
            </div>
            <div v-if="item.description">
              <h3 class="text-sm font-medium text-gray-500 mb-1">Description</h3>
              <p class="text-gray-900">{{ item.description }}</p>
            </div>
          </div>
        </div>

        <!-- Activity Tab -->
        <div v-if="activeTab === 'activity'">
          <div class="text-center py-8 text-gray-500">
            <p>Activity history coming soon</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup>
import { Badge, Button } from 'frappe-ui'
import { ArrowLeft } from 'lucide-vue-next'
import { createResource } from 'frappe-ui'
import { ref, computed } from 'vue'
import { useRouter, useRoute } from 'vue-router'

const router = useRouter()
const route = useRoute()

// Config
const doctype = "{{ doctype }}"

// State
const item = ref({})
const loading = ref(false)
const activeTab = ref("details")

const tabs = [
  { key: "details", label: "Details" },
  { key: "activity", label: "Activity" },
]

// API Resource
const resource = createResource({
  url: "{{ app_name }}.api.get_{{ snake_doctype }}",
  params: {
    name: route.params.name
  },
  auto: true,
  onSuccess: (data) => {
    item.value = data
  }
})

// Methods
function submit() {
  // Submit logic
}

function edit() {
  router.push(`${route.path}/edit`)
}

function getStatusTheme(status) {
  const themes = {
    Draft: "gray",
    Active: "green",
    Inactive: "red"
  }
  return themes[status] || "gray"
}

function formatDate(dateString) {
  if (!dateString) return "-"
  return new Date(dateString).toLocaleDateString()
}
</script>
